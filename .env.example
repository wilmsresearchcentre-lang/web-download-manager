# Optional: only needed if Gemini API features are enabled.
GEMINI_API_KEY=""

# Public URL of the hosted app.
APP_URL="https://web-download-manager-production-18d1.up.railway.app"
VITE_APP_URL="https://web-download-manager-production-18d1.up.railway.app"

# Optional yt-dlp proxy, for example: http://user:password@proxy.example.com:8080
PROXY_URL=""
# Or provide a host/IP and port separately.
PROXY_SERVER=""
PROXY_PORT=""
YTDLP_TIMEOUT_MS="120000"

# Server port.
PORT="3000"
NODE_ENV="development"
